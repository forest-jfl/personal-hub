[Unit]
Description=Personal Hub Web Service
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
# 运行用户：请确保 /opt/personal-hub 目录及其 .env、uploads 归该用户所有
User=www-data
WorkingDirectory=/opt/personal-hub
# 由该文件注入环境变量（KEY=VALUE，支持 # 注释）
EnvironmentFile=/opt/personal-hub/.env
ExecStart=/usr/bin/node /opt/personal-hub/dist/server.js
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=personal-hub

[Install]
WantedBy=multi-user.target
