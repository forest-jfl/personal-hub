# ============================================================
# Personal Hub - 环境变量示例
# 复制为 .env 后按你的服务器修改（部署时由 systemd EnvironmentFile 读取）
# ============================================================

# ---- 服务 ----
# production 关闭堆栈泄露并精简日志；development 开启 pretty 日志
NODE_ENV=production
# 监听端口（Nginx 反代到该端口）
PORT=3000
# 监听地址：放在 Nginx 之后建议只监听本机回环
HOST=127.0.0.1
# 对外基址（生成链接/重定向用，填你的域名或公网 IP）
PUBLIC_BASE_URL=http://your-domain-or-ip
# 业务时区（IANA 名）。展示、写库、调度的唯一口径来源。
# 库里时间列全是 DATETIME（原样存墙上时间），口径错配不会报错、只会静默偏 8 小时，
# 所以这一项只在一处声明、各处引用；不要用 new Date() 取进程本地时区。
BUSINESS_TZ=Asia/Shanghai

# ---- 数据库 (MySQL / MariaDB) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=personal_hub
DB_PASSWORD=change_me_strong_password
DB_NAME=personal_hub
DB_CONNECTION_LIMIT=10
# 库内 DATETIME 列的时区口径，交给 mysql2 的 timezone 选项。
# 库里的时间列全是 DATETIME（原样存墙上时间、不做换算），驱动必须按同一口径把它
# 还原成绝对时刻，否则读出的 Date 会整体偏 8 小时。若留空，mysql2 默认 'local'
# 会用进程 TZ 解释 —— 等于把正确性押在「TZ 没丢」上。
# 必须与 docker-compose 里 db 服务的 TZ、以及 BUSINESS_TZ 同口径（中国无夏令时，
# Asia/Shanghai ≡ +08:00）。
DB_TZ_OFFSET=+08:00

# ---- 会话 (Cookie) ----
# 至少 32 位随机字符串；可用:  openssl rand -hex 32
SESSION_SECRET=change_me_session_secret_at_least_32_chars
# 会话有效期（毫秒），默认 24 小时
SESSION_MAX_AGE=86400000
# 启用了 HTTPS 才设为 true（Cookie 仅经 TLS 传输）
SESSION_SECURE=false
# 前端托管在 GitHub Pages / Gitee Pages 等跨站场景时设为 true
# （Cookie 以 SameSite=None 下发，必须配合 SESSION_SECURE=true 与 HTTPS）
SESSION_CROSS_SITE=false

# ---- 跨域 (CORS) ----
# 前端托管在 git 平台时的 Pages 来源白名单（逗号分隔）。
# 本地运行（Express 同源托管前端）留空即可。
# 例：CORS_ORIGINS=https://workalin.github.io,https://workalin.gitee.io
CORS_ORIGINS=

# ---- 文件上传 ----
# 上传文件存放目录（绝对或相对路径均可，服务会自动创建）
UPLOAD_DIR=./uploads
# 单文件大小上限（字节），默认 50MB
MAX_FILE_SIZE=52428800

# ---- 初始管理员（首次建库时播种，之后改密码请到页面操作）----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password
ADMIN_DISPLAY_NAME=Administrator

# ---- 注册开关 ----
# 是否开放自主注册；暴露公网怕被刷注册时设为 false
REGISTER_ENABLED=true

# ---- 上传配额与账号限制 ----
# 每个账号的文件空间总配额（MB）
FILE_QUOTA_MB=100
# 同一 IP 最多可自主注册的账号数（管理员创建的账号不受限）
MAX_ACCOUNTS_PER_IP=10

# ============================================================
# ---- 登录通知（推送给管理员）----
# ============================================================
# 总开关
NOTIFY_ENABLED=false
# 推送渠道：wecom(企业微信自建应用，推荐) | serverchan(Server酱) | pushplus | webhook(钉钉/飞书机器人)
NOTIFY_CHANNEL=wecom
# 只关注特定账号的登录事件（逗号分隔用户名）；留空 = 推送全部账号
NOTIFY_WATCH_USERS=

# -- 企业微信自建应用（推荐：免费、稳定、微信内可收）--
# 注册企业微信(免费) → 管理后台创建「自建应用」→ 拿到 corpid / secret / agentid
# 成员在微信中关注「微工作台」即可在微信里收到推送
NOTIFY_WECOM_CORPID=
NOTIFY_WECOM_SECRET=
NOTIFY_WECOM_AGENTID=0
# 接收成员账号，@all = 应用可见范围内全部成员
NOTIFY_WECOM_TOUSER=@all

# -- Server酱（最省事：sct.ftqq.com 扫码拿 SendKey，免费版每天限 5 条）--
NOTIFY_SERVERCHAN_SENDKEY=

# -- PushPlus（pushplus.plus 微信公众号渠道）--
NOTIFY_PUSHPLUS_TOKEN=

# -- 通用 Webhook（钉钉/飞书自定义机器人，按 URL 自动适配报文格式）--
NOTIFY_WEBHOOK_URL=
# 「接收消息服务器URL」回调验签参数（后台设置企业可信IP的前置要求）
# URL 填：https://你的域名/api/wecom/callback
NOTIFY_WECOM_TOKEN=
NOTIFY_WECOM_AESKEY=

# ============================================================
# ---- 每日内容抓取（RSS → 待审草稿 → 控制台确认后发布）----
# ============================================================
# 总开关。设为 true 后，应用启动即挂载调度器，每天 FEED_TIME 执行一次。
FEED_ENABLED=false
# 触发时间（24 小时制 HH:MM），时区由 FEED_TZ 决定
FEED_TIME=08:30
# 调度时区。显式指定可避免容器默认 UTC 导致 8 小时偏移（务必保留）
FEED_TZ=Asia/Shanghai
# 进程在触发时刻之后才启动时，当日补跑一次（每天至多一次）
FEED_CATCH_UP=true
# 启动后立即执行一次（部署验证用，验证完建议改回 false）
FEED_RUN_ON_START=false
# 启用的来源 id（逗号分隔），留空 = 内置默认启用集合（sspai,ithome,oschina）
# 可用 id：sspai(少数派) / ithome(IT之家) / oschina(开源中国) / infoq(已停更) / 36kr(非RSS)
FEED_SOURCES=
# 单源单次最多入库条数
FEED_MAX_ITEMS=6
# 新鲜度阈值（天）：pubDate 超过该天数的条目丢弃（防来源站 RSS 长期停更灌入历史内容）
FEED_MAX_AGE_DAYS=7
# 摘录最大字符数（合规：只摘导语，不全文转载）
FEED_EXCERPT_CHARS=420
# RSS 摘要被判为低质（推广文案/过短）时，回退抓取原文页 og:description
FEED_FETCH_OG=true
# 每个来源单次最多尝试几次原文页回退（原文页较慢，需封顶）
FEED_MAX_OG_PER_SOURCE=3
# 入库初始状态：draft = 待人工审核后发布（推荐）；published = 直接上线
FEED_PUBLISH_STATUS=draft
# 源定义未指定分类时的兜底分类
FEED_CATEGORY=资讯
# 跨源同题软去重：标题归一化后相同且在该天数内则跳过（防同一新闻多源重复入库）
FEED_DEDUP_TITLE=true
FEED_DEDUP_TITLE_DAYS=7
# 抓取超时与重试
FEED_TIMEOUT_MS=15000
FEED_RETRIES=2
# 抓取 User-Agent（建议带站点地址，便于源站识别与联络）
# FEED_USER_AGENT=PersonalHubFeedBot/1.0 (+https://blog.jiangfulin.com)
# 运行结果推送给管理员（复用下方 NOTIFY_* 渠道；需 NOTIFY_ENABLED=true）
FEED_NOTIFY=true
# 主页「今日更新」区块最多展示条数
FEED_DAILY_LIMIT=8
