# ============================================================
# Personal Hub - 环境变量示例
# 复制为 .env 后按你的服务器修改（部署时由 systemd EnvironmentFile 读取）
# ============================================================

# ---- 服务 ----
# production 关闭堆栈泄露并精简日志；development 开启 pretty 日志
NODE_ENV=production
# 监听端口（Nginx 反代到该端口）
PORT=3000
# 监听地址：放在 Nginx 之后建议只监听本机回环
HOST=127.0.0.1
# 对外基址（生成链接/重定向用，填你的域名或公网 IP）
PUBLIC_BASE_URL=http://your-domain-or-ip

# ---- 数据库 (MySQL / MariaDB) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=personal_hub
DB_PASSWORD=change_me_strong_password
DB_NAME=personal_hub
DB_CONNECTION_LIMIT=10

# ---- 会话 (Cookie) ----
# 至少 32 位随机字符串；可用:  openssl rand -hex 32
SESSION_SECRET=change_me_session_secret_at_least_32_chars
# 会话有效期（毫秒），默认 24 小时
SESSION_MAX_AGE=86400000
# 启用了 HTTPS 才设为 true（Cookie 仅经 TLS 传输）
SESSION_SECURE=false

# ---- 文件上传 ----
# 上传文件存放目录（绝对或相对路径均可，服务会自动创建）
UPLOAD_DIR=./uploads
# 单文件大小上限（字节），默认 50MB
MAX_FILE_SIZE=52428800

# ---- 初始管理员（首次建库时播种，之后改密码请到页面操作）----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password
ADMIN_DISPLAY_NAME=Administrator
