{
  "name": "personal-hub",
  "version": "1.0.0",
  "description": "个人文件管理与博客平台（Node.js + TypeScript + Express + MySQL/MariaDB）",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mysql-session": "^3.0.1",
    "express-session": "^1.18.0",
    "marked": "^12.0.2",
    "multer": "^2.2.0",
    "mysql2": "^3.11.0",
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.0",
    "sanitize-html": "^2.17.7",
    "ws": "^8.21.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/express-mysql-session": "^3.0.0",
    "@types/express-session": "^1.18.0",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/ws": "^8.18.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
